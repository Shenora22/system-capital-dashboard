# Copy this file to .env and fill in the values. Never commit .env.
# chmod 600 .env   (on Linux/macOS) keeps other users on the server from reading it.

# --- Twitch (https://dev.twitch.tv/console) -----------------------------------
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_GAME_NAME=Grand Theft Auto VI
# Only set this if the automatic category lookup fails:
# TWITCH_GAME_ID=123456789
TWITCH_LOOKBACK_HOURS=24

# --- Gemini (https://aistudio.google.com/app/apikey) --------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- YouTube (client file comes from Google Cloud, see docs/PART1) ------------
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# Keep "private" until your API project passes YouTube's API audit. Then "public".
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=20

# --- Rendering -----------------------------------------------------------------
CLIPS_PER_SHORT=5
MAX_SHORT_SECONDS=58
# Linux default. On macOS with Homebrew: /opt/homebrew/share/... or any .ttf you like.
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
RENDER_PRESET=veryfast
RENDER_THREADS=2

# --- Housekeeping ----------------------------------------------------------------
KEEP_OUTPUT=false
# WORK_DIR=work
# OUTPUT_DIR=output
# STATE_DIR=state
# LOG_DIR=logs
